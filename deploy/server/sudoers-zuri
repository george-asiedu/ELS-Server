# Installed by setup.sh as /etc/sudoers.d/zuri-deploy. The deploy user (and so
# GitHub Actions) may restart and inspect the Zuri services, nothing else.
deploy ALL=(root) NOPASSWD: /usr/bin/systemctl restart zuri-api, /usr/bin/systemctl is-active zuri-api, /usr/bin/systemctl status zuri-api, /usr/bin/systemctl restart zuri-worker, /usr/bin/systemctl is-active zuri-worker, /usr/bin/systemctl status zuri-worker
