# The Zuri web API. Background work (queues and scheduled jobs) runs in the
# separate zuri-worker service, so it never slows requests down. Installed by setup.sh as /etc/systemd/system/zuri-api.service.
#
#   systemctl status zuri-api          is it running?
#   journalctl -u zuri-api -f          follow its logs
#   sudo systemctl restart zuri-api    restart (deploys do this for you)

[Unit]
Description=Zuri API
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=zuri
Group=zuri
# `current` points at the newest release and is resolved at each start.
WorkingDirectory=/srv/zuri-api/current
EnvironmentFile=/etc/zuri/api.env
# Set here so they can't drift: HTTP on loopback only, behind Nginx (one hop).
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=5060
Environment=TRUST_PROXY_HOPS=1
Environment=APP_ROLE=api
Environment=SCHEDULER_ENABLED=false
ExecStart=/usr/bin/node --enable-source-maps dist/app.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

# The app reads its code and config and writes nothing on disk.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LimitNOFILE=65536
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
