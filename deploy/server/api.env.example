# Zuri Studios API settings on the VPS: /etc/zuri/api.env (root:zuri, 640).
# Edit with `sudoedit /etc/zuri/api.env`, then `sudo systemctl restart zuri-api`.
# NODE_ENV, HOST, PORT, TRUST_PROXY_HOPS and SCHEDULER_ENABLED are set by the
# systemd service. Generate secrets with `openssl rand -hex 48`.

# Database and Redis: filled in by setup.sh.
DATABASE_URL="postgresql://zuri:__DB_PASSWORD__@127.0.0.1:5432/zuri"
REDIS_URL="redis://:__REDIS_PASSWORD__@127.0.0.1:6379/1"

JWT_SECRET=
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRES=3d

# Encrypts authenticator-app secrets: `openssl rand -base64 32`. Set it once and
# NEVER change it, or everyone's two-step sign-in stops working.
TOTP_ENCRYPTION_KEY=
# Two-step sign-in is optional for admins. Set true to make it mandatory.
REQUIRE_2FA_FOR_ADMINS=false

ROOT_DOMAIN=zuristudios.com
CLIENT_URL=https://zuristudios.com
COOKIE_SAMESITE=lax

# Media bucket (served publicly through CloudFront).
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_CLOUDFRONT_URL=

PLUNK_SECRET_KEY=
SENDER_EMAIL=
# Shown as the platform contact (support lines, "paid to" on receipts). The From
# address stays SENDER_EMAIL. Defaults to zuristudios53@gmail.com.
PLATFORM_EMAIL=

# Paystack LIVE keys. Webhook (set in the Paystack dashboard):
# https://api.zuristudios.com/api/payments/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Web push (VAPID). Generate ONCE with `npx web-push generate-vapid-keys` and
# never regenerate: existing subscriptions stop working. Push is off without them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:customersupport@zuristudios.com

# Automatic WhatsApp booking messages (Meta WhatsApp Cloud API). Optional: off
# until the token and number id are set. See docs in the web repo, WHATSAPP.md.
# Use a permanent System User token, never the 24-hour test token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_CONFIRMED=booking_confirmed
WHATSAPP_TEMPLATE_REMINDER=booking_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en

# Nightly backups also go here when set. A PRIVATE bucket, never the media
# one. The AWS keys above need s3:PutObject on it.
BACKUP_BUCKET=

# Security check (Cloudflare Turnstile) on guest bookings, orders, bill payments
# and Mobile Money prompts. Required in production.
TURNSTILE_SECRET_KEY=
# Where emails fetch the Zuri logo from.
API_PUBLIC_URL="https://api.zuristudios.com"
