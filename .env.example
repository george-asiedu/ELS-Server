# Local development settings. Copy to .env. Production uses
# deploy/server/api.env.example instead (see docs/DEPLOYMENT.md).

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8080
# Apex host of the platform; its subdomains are studios. Leave empty locally.
ROOT_DOMAIN=
# Where emails fetch the Zuri logo from.
API_PUBLIC_URL=http://localhost:5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/zuri"

# Redis (queues for email, push and WhatsApp). Optional: without it the app
# sends emails and pushes itself, inline.
REDIS_URL=

# Which part of the app this process runs: all (default), api or worker.
APP_ROLE=
# Recurring jobs (reminders, payment checks). On by default only in production.
SCHEDULER_ENABLED=

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRES=7d

# Session cookie. Keep lax unless the site and API are on different sites
# (the Vercel + Render development setup needs none).
COOKIE_SAMESITE=lax

# Two-step sign-in: encrypts authenticator secrets (openssl rand -base64 32).
# Optional in development; set it in production and never change it.
TOTP_ENCRYPTION_KEY=
# Set true to make two-step sign-in mandatory for admins.
REQUIRE_2FA_FOR_ADMINS=false

# AWS S3 + CloudFront (image uploads, served publicly). Required.
AWS_S3_BUCKET_NAME=your-bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=eu-central-1
AWS_CLOUDFRONT_URL=https://your-distribution.cloudfront.net

# Email (Plunk). SENDER_EMAIL must be on a domain verified in Plunk.
PLUNK_SECRET_KEY=your-plunk-secret-key
SENDER_EMAIL=no-reply@example.com
# Shown as the platform contact. Defaults to zuristudios53@gmail.com.
PLATFORM_EMAIL=
# Only if receipts arrive without the PDF: https://api.useplunk.com/v1/email/send
PLUNK_API_URL=

# Paystack (payments). Use test keys locally.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Web push (VAPID). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:customersupport@zuristudios.com

# WhatsApp booking messages (Meta WhatsApp Cloud API). Off until both are set.
# Create two message templates in WhatsApp Manager and get them approved:
#   booking_confirmed: "Hi {{1}}, your booking at {{2}} is confirmed: {{3}} on {{4}} at {{5}}."
#   booking_reminder:  "Hi {{1}}, a reminder from {{2}}: {{3}} on {{4}} at {{5}}, {{6}}."
# Studios then switch WhatsApp messages on in their dashboard (Contact page).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_CONFIRMED=booking_confirmed
WHATSAPP_TEMPLATE_REMINDER=booking_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional extra fixed guest keys (the live key is managed in the super admin Settings).
GUEST_API_KEYS=

# Cloudflare Turnstile (the security check on guest bookings, orders, bill
# payments and Mobile Money prompts). Required in production.
# Cloudflare test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
