# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8080

# Database (MongoDB connection string, must be a replica set for Prisma transactions)
DATABASE_URL="mongodb://localhost:27017/els?replicaSet=rs0"

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRES=7d

# AWS S3 (image uploads)
AWS_S3_BUCKET_NAME=els-beauty-studio
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_CLOUDFRONT_URL=https://your-distribution.cloudfront.net

# SendGrid (password reset emails)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDER_EMAIL=no-reply@example.com

# Paystack (payments)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Recurring jobs (reminders, payment reconciliation). Defaults to true only
# when NODE_ENV=production; set explicitly to override.
SCHEDULER_ENABLED=


# Session cookie. Keep lax unless the site and API are on different domains
# (the Vercel + Render development setup needs none).
COOKIE_SAMESITE=lax

# Two-step sign-in: encrypts authenticator secrets. 32 random bytes, base64
# (openssl rand -base64 32). Optional in development; set it in production and
# never change it.
TOTP_ENCRYPTION_KEY=
# Web push. Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:customersupport@zuristudios.com

# WhatsApp booking messages (Meta WhatsApp Cloud API). Off until both are set.
# Create two message templates in WhatsApp Manager and get them approved:
#   booking_confirmed: "Hi {{1}}, your booking at {{2}} is confirmed: {{3}} on {{4}} at {{5}}."
#   booking_reminder:  "Hi {{1}}, a reminder from {{2}}: {{3}} on {{4}} at {{5}}, {{6}}."
# Studios then switch WhatsApp messages on in their dashboard (Contact page).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_CONFIRMED=booking_confirmed
WHATSAPP_TEMPLATE_REMINDER=booking_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en

# Optional extra fixed guest keys (the live key is managed in the super admin Settings).
GUEST_API_KEYS=

# Cloudflare Turnstile (the security check on guest bookings, orders and bill payments).
# Required in production. Cloudflare test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
