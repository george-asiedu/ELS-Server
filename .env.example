# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8080

# Database (MongoDB connection string, must be a replica set for Prisma transactions)
DATABASE_URL="mongodb://localhost:27017/els?replicaSet=rs0"

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRES=7d

# AWS S3 (image uploads)
AWS_S3_BUCKET_NAME=els-beauty-studio
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# SendGrid (password reset emails)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDER_EMAIL=no-reply@example.com
