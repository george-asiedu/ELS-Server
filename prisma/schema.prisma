generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum StudioStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum FeatureRequestStatus {
  NEW
  PLANNED
  IN_PROGRESS
  DONE
  DECLINED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  // A customer has asked to move a confirmed booking. The new slot is already
  // held on the row (so nobody else can take it) but the studio has not agreed
  // to it yet — approving returns the booking to CONFIRMED.
  PENDING_RESCHEDULE
  COMPLETED
  CANCELLED
  // The customer didn't come. Any deposit stays with the studio.
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  FULL
  PARTIAL
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  REFERRAL_BONUS
  REFUND
  EXPIRED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  // Being packed or made.
  PREPARING
  // Pickup orders: ready to collect.
  READY_FOR_PICKUP
  // Delivery orders: with the rider.
  OUT_FOR_DELIVERY
  // Delivered or collected.
  FULFILLED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

// Where a studio's promo banner shows: the shop, the booking page, or both.
enum PromoPlacement {
  SHOP
  BOOKING
  BOTH
}

// Subscription plan a studio is on. Premium = Standard + the online shop.
// STANDARD: booking. PREMIUM: booking + shop. STOREFRONT (Zuri Storefront):
// a shop on its own, for any seller (not just beauty studios).
enum StudioPlan {
  STANDARD
  PREMIUM
  STOREFRONT
}

enum BillingCadence {
  MONTHLY
  YEARLY
}

enum BillingMode {
  SUBSCRIPTION
  REVENUE_SHARE
}

// A paid self-serve signup, held until Paystack confirms the first payment,
// then turned into a real Studio.
enum SignupStatus {
  PENDING
  PROVISIONED
  FAILED
}

// ------------------- Multi-tenant platform -------------------
// A Studio is a tenant. Every customer-facing model carries a `studioId`
// discriminator (a plain indexed scalar, not a Prisma relation, to keep this
// model free of ~25 back-relations). Tenant scoping is enforced at the data
// layer via the tenant Prisma extension — see src/tenant.

model Studio {
  id                      String       @id @default(cuid())
  name                    String
  // URL slug that maps a subdomain to this studio, e.g. "els" -> els.app.com
  slug                    String       @unique
  // Optional vanity domain pointed at the platform. Not @unique: Mongo rejects
  // multiple null docs on a unique index, and most studios have no custom
  // domain. Uniqueness is enforced in code. Only routes traffic once verified
  // via a DNS TXT record.
  customDomain            String?
  customDomainVerifyToken String?
  customDomainVerified    Boolean      @default(false)
  status                  StudioStatus @default(ACTIVE)
  // The studio's primary ADMIN user (its owner).
  ownerUserId             String?

  // Paystack subaccount code for split settlement (money -> the studio).
  paystackSubaccountCode String?
  // Percentage of each transaction the PLATFORM keeps (Paystack subaccount
  // percentage_charge). Set by the super admin; 0 = platform takes no cut.
  platformFeePercent     Float   @default(0)
  // What a shop sells (clothing, food, perfume...), picked at signup. Chooses
  // the shop website template. Null for booking-only studios.
  shopCategory           String?
  // Mobile-money settlement account the subaccount pays out to (display only;
  // the authoritative copy lives on Paystack).
  // Settlement account type: "momo" (mobile money) or "bank".
  payoutType             String? @default("momo")
  payoutProvider         String? // Paystack bank/momo settlement code
  payoutAccountNumber    String? // MoMo number or bank account number
  payoutAccountName      String?

  // Subscription / billing (platform revenue; the studio's plan gates features).
  plan                   StudioPlan     @default(STANDARD)
  billingCadence         BillingCadence @default(MONTHLY)
  // How the platform earns from this studio: a recurring plan fee
  // (SUBSCRIPTION) or a percentage cut of each customer transaction
  // (REVENUE_SHARE, where the plan sets the commission %). Chosen at signup.
  billingMode            BillingMode    @default(SUBSCRIPTION)
  paystackCustomerCode   String?
  subscriptionCode       String?
  subscriptionStatus     String? // active | lapsed | revenue_share | ...
  currentPeriodEnd       DateTime?
  // Extra storage the studio has taken, in blocks (see PlatformConfig).
  storageExtraBlocks     Int            @default(0)
  // Set by the super admin for this customer only. A custom monthly price
  // (yearly is 10x, like the list price) applies to its current plan; a
  // discount applies to every charge until it ends (no end = ongoing).
  customPriceMonthly     Float?
  billingDiscountPercent Float?
  billingDiscountEndsAt  DateTime?
  billingNote            String?

  branding        StudioBranding?
  content         StudioContent?
  generatedImages GeneratedImage[]
  settings        StudioSettings?
  featureRequests FeatureRequest[]

  // The business whose invite link this one signed up through.
  referredByStudioId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("studios")
}

// Per-studio look and feel. Colors are stored as raw HSL channels
// (e.g. "330 81% 60%") so they drop straight into the CSS design tokens.
model StudioBranding {
  id           String  @id @default(cuid())
  studioId     String  @unique
  logoUrl      String?
  primaryColor String?
  accentColor  String?
  fontFamily   String?

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studio_branding")
}

// Per-studio editable landing-page content. Every field is optional: null
// means "use the storefront's default wording/image".
model StudioContent {
  id               String  @id @default(cuid())
  studioId         String  @unique
  heroEyebrow      String?
  heroHeadline     String?
  heroSubtext      String?
  heroImageUrl     String?
  aboutHeading     String?
  aboutText        String?
  aboutImageUrl    String?
  featuresHeading  String?
  // Array of { title, description, icon } for the landing feature cards.
  featureCards     Json?
  servicesHeading  String?
  galleryHeading   String?
  reviewsHeading   String?
  loyaltyHeading   String?
  loyaltyText      String?
  ctaHeading       String?
  ctaImageUrl      String?
  contactHeading   String?
  showTestimonials Boolean @default(true)
  // What kind of studio (hair, nails, spa...): picks the website's default
  // wording. Null = general beauty studio.
  studioType       String?
  // The website's layout: editorial, bold or minimal. Null = editorial.
  siteTemplate     String?

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studio_content")
}

// Per-studio feature flags. Whole modules are hidden when disabled. Studio
// admins toggle these; the super admin can gate them at the plan level.
model StudioSettings {
  id                String  @id @default(cuid())
  studioId          String  @unique
  // Appointment booking. Off for Zuri Storefront (shop-only) accounts.
  booking           Boolean @default(true)
  // Who pays Paystack's processing fee on customer payments: CUSTOMER (added
  // at checkout, the default) or BUSINESS (taken from the studio's share; the
  // customer pays the price). The platform's commission never pays it.
  // Booking confirmations and reminders to customers on WhatsApp, when the
  // platform has WhatsApp set up. Each message is billed by Meta.
  whatsappMessages  Boolean @default(false)
  paystackFeePayer  String  @default("CUSTOMER")
  commerce          Boolean @default(false)
  loyalty           Boolean @default(true)
  referrals         Boolean @default(true)
  reviews           Boolean @default(true)
  gallery           Boolean @default(true)
  onlinePayments    Boolean @default(false)
  productsInBooking Boolean @default(false)

  // Max share of a booking a customer can pay with loyalty points (percent).
  loyaltyCapPercent Int @default(30)

  // How much warning a CUSTOMER must give to move their own booking, in hours.
  // Studio admins are not subject to it — they are the ones absorbing the
  // disruption. Default 2h; a studio wanting a full day's notice sets 24.
  rescheduleNoticeHours Int @default(2)

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studio_settings")
}

// A feature a studio requests; surfaced in the super-admin triage queue.
model FeatureRequest {
  id              String               @id @default(cuid())
  studioId        String
  title           String
  description     String
  status          FeatureRequestStatus @default(NEW)
  createdByUserId String?
  // A one-off fee the super admin sets for building it (GHS). Null until
  // decided; 0 means free. Added to the studio's next renewal.
  feeAmount       Float?
  feeSetAt        DateTime?
  // Pictures that show what they mean (up to 5), uploaded with the request.
  images          String[] @default([])

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("feature_requests")
}

// Platform/admin action trail. Not tenant-scoped: it spans studios and is read
// by the super admin. Written best-effort (never blocks the action it records).
model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actorEmail String
  actorRole  String
  action     String // e.g. "studio.provisioned", "studio.suspended"
  targetType String? // e.g. "Studio"
  targetId   String?
  studioId   String? // studio the action relates to, when applicable
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([studioId])
  @@map("audit_logs")
}

// Operational request telemetry, separate from the business/admin AuditLog.
// Contains request metadata only; never persist request bodies, query strings,
// credentials, or user email addresses here.
model PlatformActivityLog {
  id         String   @id @default(cuid())
  requestId  String
  studioId   String?
  actorId    String?
  actorRole  String?
  method     String
  route      String
  statusCode Int
  durationMs Int
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([studioId, createdAt])
  @@index([statusCode, createdAt])
  @@map("platform_activity_logs")
}

// Delivery record for every notification email the platform sends. Not
// tenant-scoped (mirrors AuditLog) — background jobs (cron, webhooks) send
// across studios with no request-scoped tenant context.
//
// The unique constraint is the idempotency guarantee: the same business event
// (a template + the entity it's about + who it went to) can only ever create
// one row, so a retried webhook/mutation/cron tick can't double-send a
// financial or booking email even if it calls notificationService.send again.
model NotificationLog {
  id         String  @id @default(cuid())
  studioId   String?
  template   String // e.g. "PAYMENT_SUCCESS" — see notifications/registry.ts
  recipient  String
  entityType String? // e.g. "Payment", "Appointment", "Order", "Studio"
  entityId   String?
  status     String // QUEUED | SENT | FAILED
  error      String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@unique([template, entityId, recipient])
  @@index([studioId])
  @@index([createdAt])
  @@map("notification_logs")
}

// A testimonial a studio submits about the platform, shown on the marketing
// landing page after the super admin approves it. Not tenant-scoped.
model PlatformReview {
  id              String  @id @default(cuid())
  studioId        String?
  authorName      String
  authorRole      String?
  content         String
  rating          Int     @default(5)
  approved        Boolean @default(false)
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved])
  @@index([studioId])
  @@map("platform_reviews")
}

// A paid self-serve studio signup, held until Paystack confirms payment, then
// provisioned into a real Studio. Not tenant-scoped (platform-level).
model StudioSignup {
  id                String         @id @default(cuid())
  name              String
  slug              String
  ownerEmail        String
  ownerPasswordHash String
  ownerFullName     String?
  plan              StudioPlan     @default(STANDARD)
  cadence           BillingCadence @default(MONTHLY)
  billingMode       BillingMode    @default(SUBSCRIPTION)
  shopCategory      String?
  // The inviting business's address (slug), from ?ref= on the signup link.
  referralSlug      String?
  promoCode         String?
  reference         String         @unique
  status            SignupStatus   @default(PENDING)
  studioId          String?
  // What this signup was charged (GHS) and, for a subscription setup fee, how
  // many months it covers. Fixed when payment starts so a later change to the
  // platform's fees can't change what this studio paid for. Null on signups
  // made before these were recorded.
  amountCharged     Float?
  coverageMonths    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("studio_signups")
}

// Singleton platform-wide billing config, editable by the super admin. Holds
// the revenue-share commission % and one-time setup fee for each plan tier.
enum ScheduledJobStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum StudioBillingChargeKind {
  RENEWAL
  PLAN_CHANGE
  // Just the extras (feature request fees, storage, training), paid now.
  EXTRAS
}

enum StudioBillingChargeStatus {
  PENDING
  APPLIED
}

// One studio-to-platform payment for a renewal or a plan change, recorded
// when it starts. Applying it uses these stored values (never ones sent by the
// browser), checks Paystack collected `amount`, and flips PENDING -> APPLIED
// once, so a paid reference can't be applied twice or for a different plan.
enum ExtraChargeKind {
  FEATURE_REQUEST
  STORAGE_OVERAGE
  TRAINING
  OTHER
}

enum ExtraChargeStatus {
  PENDING
  BILLED
  WAIVED
}

// Money a studio owes on top of its plan: a feature request fee, extra storage,
// in-person training. Pending ones are added to the next renewal and marked
// billed when that renewal is paid. One row per thing (kind + refId).
model StudioExtraCharge {
  id          String            @id @default(cuid())
  studioId    String
  kind        ExtraChargeKind
  // What it's for, in words the studio sees on its bill.
  description String
  amount      Float
  status      ExtraChargeStatus @default(PENDING)
  // The thing it belongs to: a feature request id, a "2026-11" storage month.
  refId       String
  // The renewal that billed it.
  billedReference String?
  billedAt        DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([studioId, kind, refId])
  @@index([studioId, status])
  @@map("studio_extra_charges")
}

model StudioBillingCharge {
  id        String                    @id @default(cuid())
  reference String                    @unique
  studioId  String
  kind      StudioBillingChargeKind
  plan      StudioPlan
  cadence   BillingCadence
  amount    Float
  status    StudioBillingChargeStatus @default(PENDING)
  appliedAt DateTime?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  // The billing promo used, counted once the charge is paid.
  promoCode String?

  @@index([studioId])
  @@map("studio_billing_charges")
}

// Recurring background jobs (payment reconciliation, reminders) and their
// on/off switch. Runs are claimed by updating this row, so a job runs once per
// scheduled slot even with several API instances, without needing Redis. See
// src/scheduler.
model ScheduledJob {
  key            String              @id
  enabled        Boolean             @default(true)
  // The scheduled slot (ISO start time) most recently claimed. A run is due
  // when the current slot differs from this.
  lastSlot       String?
  // Lease: while in the future, a run is in progress and nobody else starts
  // one. Expires on its own if the process dies mid-run.
  lockedUntil    DateTime?
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastStatus     ScheduledJobStatus?
  lastTrigger    String?
  lastResult     Json?
  lastError      String?
  lastDurationMs Int?
  runCount       Int                 @default(0)
  failureCount   Int                 @default(0)
  updatedBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@map("scheduled_jobs")
}

model PlatformConfig {
  id                        String  @id @default(cuid())
  // Free live online training: where to join, and when (shown to every studio and store).
  trainingLiveUrl           String?
  trainingLiveNote          String?
  // Storage for Zuri Studios plans (not Zuri Stores): included amount per plan,
  // and the size and monthly price of an extra block.
  storageStandardMb         Int     @default(500)
  storagePremiumMb          Int     @default(1024)
  storageBlockMb            Int     @default(500)
  storageBlockPrice         Float   @default(5)
  // Guest key: the web app sends it to book, pay or buy without an account.
  // Rotating moves the old one to "previous", which keeps working for a day so
  // pages that are already open don't break.
  guestKeyCurrent           String?
  guestKeyPrevious          String?
  guestKeyPreviousUntil     DateTime?
  guestKeyRotatedAt         DateTime?
  // Master switch: when off, onboarding only offers subscription billing and the
  // revenue-share (% cut) option is hidden entirely. Subscription is always the
  // default; the super admin opts in to revenue-share.
  revenueShareEnabled       Boolean @default(false)
  // Commission the platform takes per customer transaction in REVENUE_SHARE.
  commissionStandardPercent Float   @default(5)
  commissionPremiumPercent  Float   @default(8)
  // One-time activation fee (GHS) charged at signup for REVENUE_SHARE studios.
  setupFeeStandard          Float   @default(0)
  setupFeePremium           Float   @default(0)

  // Subscription setup fee (GHS) per plan, charged at signup instead of the
  // first period's price. It covers the first `setupFeeMonths*` months; the
  // normal monthly/yearly price is due after that. 0 turns it off.
  subscriptionSetupFeeStandard Float @default(0)
  subscriptionSetupFeePremium  Float @default(0)
  setupFeeMonthsMonthly        Int   @default(2)
  setupFeeMonthsYearly         Int   @default(3)

  // Plan prices (GHS). Null = the built-in default (the PLAN_* env value,
  // else 150 / 1500 / 350 / 3500), so existing pricing holds until edited.
  priceStandardMonthly           Float?
  priceStandardYearly            Float?
  pricePremiumMonthly            Float?
  pricePremiumYearly             Float?
  // Zuri Storefront (shop only): price, signup setup fee, and the
  // pay-as-you-earn commission and activation fee.
  priceStorefrontMonthly         Float?
  priceStorefrontYearly          Float?
  subscriptionSetupFeeStorefront Float  @default(0)
  commissionStorefrontPercent    Float  @default(5)
  setupFeeStorefront             Float  @default(0)

  // Public site details shown on the platform pages. Null = the frontend's
  // built-in default.
  siteName        String?
  siteHeroBadge   String?
  supportEmail    String?
  supportWhatsapp String?
  demoStudioSlug  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_config")
}

// A studio's scrolling promo banner (advertised on the shop and/or booking
// pages). Tenant-scoped like the rest of the storefront content.
model PromoBanner {
  id        String         @id @default(cuid())
  studioId  String?
  message   String
  linkUrl   String?
  bgColor   String? // hex; falls back to the studio's primary color
  textColor String?
  placement PromoPlacement @default(BOTH)
  active    Boolean        @default(true)
  order     Int            @default(0)
  // The scheduled sale this banner belongs to (shown only on its sale days).
  salePromoId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("promo_banners")
}

// A scheduled sale for a studio's or store's products: a % off on certain
// weekdays (Fridays by default) between two dates, like Black Friday. On sale
// days it puts the price down on every product that has no price of its own
// set, and shows a banner; the next day it puts them back.
model SalePromo {
  id         String   @id @default(cuid())
  studioId   String?
  name       String
  percentOff Float
  startsOn   DateTime // a day, at midnight UTC
  endsOn     DateTime
  // 0 = Sunday ... 6 = Saturday.
  weekdays   Int[]    @default([5])
  banner     Boolean  @default(true)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([studioId])
  @@map("sale_promos")
}

enum TrainingStatus {
  NEW
  SCHEDULED
  DONE
  DECLINED
}

// A studio or store asking for in-person training. Online training is free and
// needs no request; in-person has a fee the super admin sets, added to the next bill.
model TrainingRequest {
  id              String         @id @default(cuid())
  studioId        String
  requestedByUserId String?
  preferredDate   String?
  location        String?
  notes           String?
  status          TrainingStatus @default(NEW)
  feeAmount       Float?
  scheduledFor    DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([studioId])
  @@map("training_requests")
}

enum BillStatus {
  UNPAID
  PAID
  VOID
}

// A bill for a walk-in: lines the owner adds (services, products or anything
// else), a link and QR code the customer pays through on their own phone, and
// a record of it either way (paid online, paid in cash, or cancelled).
model Bill {
  id            String     @id @default(cuid())
  studioId      String?
  number        String
  customerName  String
  customerPhone String?
  customerEmail String?
  // Linked when the customer has an account with the same email.
  userId        String?
  // [{ name, quantity, unitPrice, kind: "service" | "product" | "custom" }]
  items         Json
  total         Float
  note          String?
  status        BillStatus @default(UNPAID)
  // The secret in the pay link.
  token         String     @unique
  // The latest Paystack attempt, and the fee the customer paid on top.
  reference     String?    @unique
  processingFee Float      @default(0)
  paidAt        DateTime?
  // How it was paid: "paystack", "cash", "momo", "card".
  paidVia       String?
  paidNote      String?
  createdByUserId String?
  createdAt     DateTime   @default(now())

  @@unique([studioId, number])
  @@index([studioId, status])
  @@map("bills")
}

// ------------------- Tenant-owned models -------------------

model User {
  id       String  @id @default(cuid())
  // Super admins belong to no studio (studioId is null); customers/admins do.
  studioId String?
  email    String
  password String
  role     Role    @default(CUSTOMER)

  resetToken       String?
  resetTokenExpiry DateTime?
  // Set once the email is confirmed. Owners do it before paying; customers can
  // choose to later, from their account. Nothing is blocked without it.
  emailVerifiedAt  DateTime?

  // Authenticator-app two-factor sign-in. The secret is AES-GCM encrypted;
  // totpLastStep is the last 30-second step accepted, so a code can't be reused.
  totpSecretEnc     String?
  totpEnabled       Boolean            @default(false)
  totpLastStep      Int?
  recoveryCodes     RecoveryCode[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  profile             Profile?
  appointments        Appointment[]
  reviews             Review[]
  loyaltyPoints       LoyaltyPoints?
  loyaltyTransactions LoyaltyTransaction[]
  referralCode        ReferralCode?
  referralsMade       Referral[]           @relation("Referrer")
  referralReceived    Referral?            @relation("Referred")
  cart                Cart?
  orders              Order[]
  wishlist            WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Email is unique per studio, not globally (same email can exist in two
  // studios). Super admins (studioId null) are effectively globally unique.
  @@unique([studioId, email])
  @@index([studioId])
  @@index([role])
  @@map("users")
}

// One-time codes for signing in without the authenticator app. Hashed; shown once.
model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  @@index([userId])
  @@map("recovery_codes")
}

// The in-app notifications list: everything sent as a push is also kept here,
// so it can be read in the app whether or not push is switched on.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @db.VarChar(120)
  body      String    @db.VarChar(400)
  url       String    @db.VarChar(300)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

// A browser or installed app that gets push notifications for this user.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @db.VarChar(300)
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
  @@map("push_subscriptions")
}

// Server-side bearer-token sessions allow immediate revocation and enforce a
// maximum number of active devices per account.
model AuthSession {
  id        String   @id
  userId    String
  studioId  String?
  deviceKey String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([userId, deviceKey])
  @@map("auth_sessions")
}

// A browser-generated random identifier, hashed by the API. This remembers
// known browsers after their active sessions expire so alerts are one-time per
// newly seen device rather than on every login.
model AuthDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceKey   String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@unique([userId, deviceKey])
  @@index([userId, lastSeenAt])
  @@map("auth_devices")
}

model Profile {
  id       String  @id @default(cuid())
  studioId String?
  userId   String  @unique
  fullName String?
  email    String?
  phone    String?
  avatar   String?
  location String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("profiles")
}

model Appointment {
  id              String            @id @default(cuid())
  studioId        String?
  fullName        String
  phone           String
  email           String?
  appointmentDate DateTime
  appointmentTime String
  notes           String?
  designImageUrl  String?
  status          AppointmentStatus @default(PENDING)
  // Guest bookings (no account): a private token, handed back once when the
  // booking is made, is what lets that person pay for it.
  guestToken      String?

  // Original service price at time of booking.
  totalPrice     Float?
  // Loyalty discount applied to this booking (amount due = totalPrice - discountAmount).
  discountAmount Float   @default(0)
  pointsRedeemed Int     @default(0)
  pointsRefunded Boolean @default(false)

  // Previous slot, kept when an appointment is moved so the customer's email can
  // show "was X, now Y" and the studio has a trail. Only the most recent move is
  // retained — a full history would need its own table.
  rescheduledFromDate DateTime?
  rescheduledFromTime String?
  rescheduledAt       DateTime?

  // Nullable so guests (not logged in) can book
  userId    String?
  // Who it's with, when the studio has staff. Null on older bookings and at
  // studios without staff; such bookings hold the slot for everyone.
  staffId   String?
  staff     Staff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)
  serviceId String

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  payment             Payment?
  reviews             Review[]
  loyaltyTransactions LoyaltyTransaction[]
  // Products bought as part of this booking (separate revenue bucket).
  // One-to-many at the schema level (Mongo unique-null limitation); at most one
  // product order per appointment is enforced in application code.
  productOrders       Order[]

  // The customer asked to cancel; the studio approves (status CANCELLED) or
  // declines (cleared). Refunds are settled by the studio outside the app.
  cancelRequestedAt     DateTime?
  cancelRequestReason   String?   @db.VarChar(500)
  // The studio paid the customer back itself (Mobile Money, cash, bank) and
  // recorded it here. No money moves through the platform.
  refundedOutsideAt     DateTime?
  refundedOutsideAmount Float?
  refundedOutsideNote   String?   @db.VarChar(300)
  // A gift card or package used on it, and how much it covered (already
  // included in discountAmount).
  voucherId             String?
  voucherAmount         Float     @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([studioId])
  @@index([userId])
  @@map("appointments")
}

model Service {
  id          String  @id @default(cuid())
  studioId    String?
  name        String
  category    String // Category slug (see Category model)
  description String?
  price       Float
  // When set (and below price), this is an active promotional price.
  promoPrice  Float?
  duration    String // Human readable, e.g. "2 hrs"
  popular     Boolean @default(false)
  active      Boolean @default(true)
  imageUrl    String?

  appointments Appointment[]
  addOns       ServiceAddOn[]
  reviews      Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("services")
}

model ServiceAddOn {
  id        String  @id @default(cuid())
  studioId  String?
  name      String
  price     Float
  duration  Int // Additional minutes
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("service_addons")
}

model Payment {
  id            String        @id @default(cuid())
  studioId      String?
  // Amount charged in this Paystack transaction (deposit or full), in GHS.
  amount        Float
  // Full amount due for the booking (for a partial payment, the balance is
  // totalAmount - amount, payable at the studio).
  totalAmount   Float         @default(0)
  type          PaymentType   @default(FULL)
  status        PaymentStatus @default(PENDING)
  currency      String        @default("GHS")
  // Reference we generate and hand to Paystack; Paystack echoes it back.
  // Always set (a generated UUID), globally unique so verify/webhook can find it.
  reference     String?       @unique
  // Paystack's own transaction id, captured on verify. Not unique: it's null
  // until paid, and a Mongo unique index only allows a single null document.
  transactionId String?
  channel       String?
  paidAt        DateTime?

  // Sum of PROCESSED refunds against this payment. `amount - refundedAmount` is
  // what the studio actually kept.
  refundedAmount Float @default(0)

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // Paystack fee the customer paid on top of the price (0 when the business pays it).
  processingFee Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studioId])
  @@map("payments")
}

// Per-studio payment policy (one document per studio).
// When enabled, a booking must be paid (full and/or partial, per the flags)
// before it's finalized; when disabled, bookings are created payment-pending.
model PaymentSettings {
  id             String  @id @default(cuid())
  studioId       String? @unique
  enabled        Boolean @default(false)
  allowFull      Boolean @default(true)
  allowPartial   Boolean @default(false)
  depositPercent Int     @default(50) // % of amount due required as a deposit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_settings")
}

model Review {
  id       String  @id @default(cuid())
  studioId String?
  rating   Int // 1-5
  content  String?
  approved Boolean @default(false)

  userId        String
  serviceId     String?
  appointmentId String?
  // Set for a review of a product the customer bought.
  productId     String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([studioId])
  @@index([approved])
  @@index([productId])
  @@map("reviews")
}

model Gallery {
  id        String    @id @default(cuid())
  studioId  String?
  title     String?
  imageUrl  String
  mediaType MediaType @default(IMAGE)
  category  String // Category slug (see Category model)
  active    Boolean   @default(true)
  // In the trash: hidden everywhere, still stored (and counted) until it is
  // restored or purgeAfter passes.
  deletedAt  DateTime?
  purgeAfter DateTime?
  createdAt DateTime  @default(now())

  @@index([studioId])
  @@map("gallery")
}

// Per-studio service/gallery categories with public visibility control.
model Category {
  id       String  @id @default(cuid())
  studioId String?
  name     String
  slug     String
  active   Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studioId, slug])
  @@index([studioId])
  @@map("categories")
}

model BusinessHours {
  id        String  @id @default(cuid())
  studioId  String?
  dayOfWeek Int // 0 (Sunday) to 6 (Saturday)
  openTime  String? // e.g., "09:00"
  closeTime String? // e.g., "17:00"
  isClosed  Boolean @default(false)

  @@unique([studioId, dayOfWeek])
  @@index([studioId])
  @@map("business_hours")
}

// A stylist (or chair) at a studio. Bookings can be made with a particular
// person; two staff can be booked at the same time.
model Staff {
  id           String        @id @default(cuid())
  studioId     String?
  name         String
  role         String?
  photoUrl     String?
  // Services this person does; empty means all of them.
  serviceIds   String[]      @default([])
  active       Boolean       @default(true)
  order        Int           @default(0)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([studioId])
  @@map("staff")
}

// Customers waiting for a slot on a full day. When a booking that day is
// cancelled, everyone waiting is told and the first to book gets it.
model WaitlistEntry {
  id         String    @id @default(cuid())
  studioId   String?
  serviceId  String
  date       DateTime
  userId     String?
  name       String
  email      String?
  phone      String?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([studioId, date])
  @@map("waitlist_entries")
}

// A package a studio sells: a number of sessions of one service, paid upfront.
model PackageOffer {
  id        String   @id @default(cuid())
  studioId  String?
  serviceId String
  name      String
  sessions  Int
  price     Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("package_offers")
}

// A gift card (a GHS balance) or a bought package (sessions of a service),
// identified by a code the customer uses when booking or checking out.
model Voucher {
  id             String    @id @default(cuid())
  studioId       String?
  kind           String // GIFT_CARD | PACKAGE
  code           String
  status         String    @default("PENDING") // PENDING (awaiting payment) | ACTIVE | USED
  // What was paid for it (the price), and Paystack's fee if the buyer paid it.
  price          Float
  processingFee  Float     @default(0)
  reference      String    @unique
  paidAt         DateTime?
  // Gift card: the balance left to spend.
  balance        Float     @default(0)
  // Package: the service and sessions left.
  packageOfferId String?
  serviceId      String?
  sessionsTotal  Int       @default(0)
  sessionsLeft   Int       @default(0)
  buyerUserId    String?
  buyerName      String
  buyerEmail     String
  recipientName  String?
  recipientEmail String?
  message        String?   @db.VarChar(300)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([studioId, code])
  @@index([studioId])
  @@map("vouchers")
}

// Money a business spent (rent, products, salaries…), so it can see profit.
model Expense {
  id          String   @id @default(cuid())
  studioId    String?
  date        DateTime
  category    String
  description String?  @db.VarChar(200)
  amount      Float
  createdAt   DateTime @default(now())

  @@index([studioId, date])
  @@map("expenses")
}

// A business's private notes about one of its customers ("allergic to X").
model CustomerNote {
  id        String   @id @default(cuid())
  studioId  String?
  userId    String
  notes     String   @db.VarChar(2000)
  updatedAt DateTime @updatedAt

  @@unique([studioId, userId])
  @@map("customer_notes")
}

model BlockedDate {
  id       String   @id @default(cuid())
  studioId String?
  date     DateTime
  reason   String?

  @@index([studioId])
  @@map("blocked_dates")
}

// Per-studio contact details (one document per studio).
model ContactInfo {
