generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

enum StudioStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum FeatureRequestStatus {
  NEW
  PLANNED
  IN_PROGRESS
  DONE
  DECLINED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  // A customer has asked to move a confirmed booking. The new slot is already
  // held on the row (so nobody else can take it) but the studio has not agreed
  // to it yet — approving returns the booking to CONFIRMED.
  PENDING_RESCHEDULE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  FULL
  PARTIAL
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  REFERRAL_BONUS
  REFUND
  EXPIRED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

// Where a studio's promo banner shows: the shop, the booking page, or both.
enum PromoPlacement {
  SHOP
  BOOKING
  BOTH
}

// Subscription plan a studio is on. Premium = Standard + the online shop.
enum StudioPlan {
  STANDARD
  PREMIUM
}

enum BillingCadence {
  MONTHLY
  YEARLY
}

enum BillingMode {
  SUBSCRIPTION
  REVENUE_SHARE
}

// A paid self-serve signup, held until Paystack confirms the first payment,
// then turned into a real Studio.
enum SignupStatus {
  PENDING
  PROVISIONED
  FAILED
}

// ------------------- Multi-tenant platform -------------------
// A Studio is a tenant. Every customer-facing model carries a `studioId`
// discriminator (a plain indexed scalar, not a Prisma relation, to keep this
// model free of ~25 back-relations). Tenant scoping is enforced at the data
// layer via the tenant Prisma extension — see src/tenant.

model Studio {
  id                      String       @id @default(cuid())
  name                    String
  // URL slug that maps a subdomain to this studio, e.g. "els" -> els.app.com
  slug                    String       @unique
  // Optional vanity domain pointed at the platform. Not @unique: Mongo rejects
  // multiple null docs on a unique index, and most studios have no custom
  // domain. Uniqueness is enforced in code. Only routes traffic once verified
  // via a DNS TXT record.
  customDomain            String?
  customDomainVerifyToken String?
  customDomainVerified    Boolean      @default(false)
  status                  StudioStatus @default(ACTIVE)
  // The studio's primary ADMIN user (its owner).
  ownerUserId             String?

  // Paystack subaccount code for split settlement (money -> the studio).
  paystackSubaccountCode String?
  // Percentage of each transaction the PLATFORM keeps (Paystack subaccount
  // percentage_charge). Set by the super admin; 0 = platform takes no cut.
  platformFeePercent     Float   @default(0)
  // Mobile-money settlement account the subaccount pays out to (display only;
  // the authoritative copy lives on Paystack).
  // Settlement account type: "momo" (mobile money) or "bank".
  payoutType             String? @default("momo")
  payoutProvider         String? // Paystack bank/momo settlement code
  payoutAccountNumber    String? // MoMo number or bank account number
  payoutAccountName      String?

  // Subscription / billing (platform revenue; the studio's plan gates features).
  plan                 StudioPlan     @default(STANDARD)
  billingCadence       BillingCadence @default(MONTHLY)
  // How the platform earns from this studio: a recurring plan fee
  // (SUBSCRIPTION) or a percentage cut of each customer transaction
  // (REVENUE_SHARE, where the plan sets the commission %). Chosen at signup.
  billingMode          BillingMode    @default(SUBSCRIPTION)
  paystackCustomerCode String?
  subscriptionCode     String?
  subscriptionStatus   String? // active | lapsed | revenue_share | ...
  currentPeriodEnd     DateTime?

  branding        StudioBranding?
  content         StudioContent?
  settings        StudioSettings?
  featureRequests FeatureRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studios")
}

// Per-studio look and feel. Colors are stored as raw HSL channels
// (e.g. "330 81% 60%") so they drop straight into the CSS design tokens.
model StudioBranding {
  id           String  @id @default(cuid())
  studioId     String  @unique
  logoUrl      String?
  primaryColor String?
  accentColor  String?
  fontFamily   String?

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studio_branding")
}

// Per-studio editable landing-page content. Every field is optional: null
// means "use the storefront's default wording/image".
model StudioContent {
  id               String  @id @default(cuid())
  studioId         String  @unique
  heroEyebrow      String?
  heroHeadline     String?
  heroSubtext      String?
  heroImageUrl     String?
  aboutHeading     String?
  aboutText        String?
  aboutImageUrl    String?
  featuresHeading  String?
  // Array of { title, description, icon } for the landing feature cards.
  featureCards     Json?
  servicesHeading  String?
  galleryHeading   String?
  reviewsHeading   String?
  loyaltyHeading   String?
  loyaltyText      String?
  ctaHeading       String?
  ctaImageUrl      String?
  contactHeading   String?
  showTestimonials Boolean @default(true)

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studio_content")
}

// Per-studio feature flags. Whole modules are hidden when disabled. Studio
// admins toggle these; the super admin can gate them at the plan level.
model StudioSettings {
  id                String  @id @default(cuid())
  studioId          String  @unique
  commerce          Boolean @default(false)
  loyalty           Boolean @default(true)
  referrals         Boolean @default(true)
  reviews           Boolean @default(true)
  gallery           Boolean @default(true)
  onlinePayments    Boolean @default(false)
  productsInBooking Boolean @default(false)

  // Max share of a booking a customer can pay with loyalty points (percent).
  loyaltyCapPercent Int @default(30)

  // How much warning a CUSTOMER must give to move their own booking, in hours.
  // Studio admins are not subject to it — they are the ones absorbing the
  // disruption. Default 2h; a studio wanting a full day's notice sets 24.
  rescheduleNoticeHours Int @default(2)

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studio_settings")
}

// A feature a studio requests; surfaced in the super-admin triage queue.
model FeatureRequest {
  id              String               @id @default(cuid())
  studioId        String
  title           String
  description     String
  status          FeatureRequestStatus @default(NEW)
  createdByUserId String?

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("feature_requests")
}

// Platform/admin action trail. Not tenant-scoped: it spans studios and is read
// by the super admin. Written best-effort (never blocks the action it records).
model AuditLog {
  id         String  @id @default(cuid())
  actorId    String?
  actorEmail String
  actorRole  String
  action     String // e.g. "studio.provisioned", "studio.suspended"
  targetType String? // e.g. "Studio"
  targetId   String?
  studioId   String? // studio the action relates to, when applicable
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([studioId])
  @@map("audit_logs")
}

// Operational request telemetry, separate from the business/admin AuditLog.
// Contains request metadata only; never persist request bodies, query strings,
// credentials, or user email addresses here.
model PlatformActivityLog {
  id         String   @id @default(cuid())
  requestId  String
  studioId   String?
  actorId    String?
  actorRole  String?
  method     String
  route      String
  statusCode Int
  durationMs Int
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([studioId, createdAt])
  @@index([statusCode, createdAt])
  @@map("platform_activity_logs")
}

// Delivery record for every notification email the platform sends. Not
// tenant-scoped (mirrors AuditLog) — background jobs (cron, webhooks) send
// across studios with no request-scoped tenant context.
//
// The unique constraint is the idempotency guarantee: the same business event
// (a template + the entity it's about + who it went to) can only ever create
// one row, so a retried webhook/mutation/cron tick can't double-send a
// financial or booking email even if it calls notificationService.send again.
model NotificationLog {
  id         String  @id @default(cuid())
  studioId   String?
  template   String // e.g. "PAYMENT_SUCCESS" — see notifications/registry.ts
  recipient  String
  entityType String? // e.g. "Payment", "Appointment", "Order", "Studio"
  entityId   String?
  status     String // QUEUED | SENT | FAILED
  error      String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@unique([template, entityId, recipient])
  @@index([studioId])
  @@index([createdAt])
  @@map("notification_logs")
}

// A testimonial a studio submits about the platform, shown on the marketing
// landing page after the super admin approves it. Not tenant-scoped.
model PlatformReview {
  id              String  @id @default(cuid())
  studioId        String?
  authorName      String
  authorRole      String?
  content         String
  rating          Int     @default(5)
  approved        Boolean @default(false)
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approved])
  @@index([studioId])
  @@map("platform_reviews")
}

// A paid self-serve studio signup, held until Paystack confirms payment, then
// provisioned into a real Studio. Not tenant-scoped (platform-level).
model StudioSignup {
  id                String         @id @default(cuid())
  name              String
  slug              String
  ownerEmail        String
  ownerPasswordHash String
  ownerFullName     String?
  plan              StudioPlan     @default(STANDARD)
  cadence           BillingCadence @default(MONTHLY)
  billingMode       BillingMode    @default(SUBSCRIPTION)
  reference         String         @unique
  status            SignupStatus   @default(PENDING)
  studioId          String?
  // What this signup was charged (GHS) and, for a subscription setup fee, how
  // many months it covers. Fixed when payment starts so a later change to the
  // platform's fees can't change what this studio paid for. Null on signups
  // made before these were recorded.
  amountCharged     Float?
  coverageMonths    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("studio_signups")
}

// Singleton platform-wide billing config, editable by the super admin. Holds
// the revenue-share commission % and one-time setup fee for each plan tier.
enum ScheduledJobStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum StudioBillingChargeKind {
  RENEWAL
  PLAN_CHANGE
}

enum StudioBillingChargeStatus {
  PENDING
  APPLIED
}

// One studio-to-platform payment for a renewal or a plan change, recorded
// when it starts. Applying it uses these stored values (never ones sent by the
// browser), checks Paystack collected `amount`, and flips PENDING -> APPLIED
// once, so a paid reference can't be applied twice or for a different plan.
model StudioBillingCharge {
  id        String                    @id @default(cuid())
  reference String                    @unique
  studioId  String
  kind      StudioBillingChargeKind
  plan      StudioPlan
  cadence   BillingCadence
  amount    Float
  status    StudioBillingChargeStatus @default(PENDING)
  appliedAt DateTime?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([studioId])
  @@map("studio_billing_charges")
}

// Recurring background jobs (payment reconciliation, reminders) and their
// on/off switch. Runs are claimed by updating this row, so a job runs once per
// scheduled slot even with several API instances, without needing Redis. See
// src/scheduler.
model ScheduledJob {
  key            String              @id
  enabled        Boolean             @default(true)
  // The scheduled slot (ISO start time) most recently claimed. A run is due
  // when the current slot differs from this.
  lastSlot       String?
  // Lease: while in the future, a run is in progress and nobody else starts
  // one. Expires on its own if the process dies mid-run.
  lockedUntil    DateTime?
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastStatus     ScheduledJobStatus?
  lastTrigger    String?
  lastResult     Json?
  lastError      String?
  lastDurationMs Int?
  runCount       Int                 @default(0)
  failureCount   Int                 @default(0)
  updatedBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@map("scheduled_jobs")
}

model PlatformConfig {
  id                        String  @id @default(cuid())
  // Master switch: when off, onboarding only offers subscription billing and the
  // revenue-share (% cut) option is hidden entirely. Subscription is always the
  // default; the super admin opts in to revenue-share.
  revenueShareEnabled       Boolean @default(false)
  // Commission the platform takes per customer transaction in REVENUE_SHARE.
  commissionStandardPercent Float   @default(5)
  commissionPremiumPercent  Float   @default(8)
  // One-time activation fee (GHS) charged at signup for REVENUE_SHARE studios.
  setupFeeStandard          Float   @default(0)
  setupFeePremium           Float   @default(0)

  // Subscription setup fee (GHS) per plan, charged at signup instead of the
  // first period's price. It covers the first `setupFeeMonths*` months; the
  // normal monthly/yearly price is due after that. 0 turns it off.
  subscriptionSetupFeeStandard Float @default(0)
  subscriptionSetupFeePremium  Float @default(0)
  setupFeeMonthsMonthly        Int   @default(2)
  setupFeeMonthsYearly         Int   @default(3)

  // Plan prices (GHS). Null = the built-in default (the PLAN_* env value,
  // else 150 / 1500 / 350 / 3500), so existing pricing holds until edited.
  priceStandardMonthly Float?
  priceStandardYearly  Float?
  pricePremiumMonthly  Float?
  pricePremiumYearly   Float?

  // Public site details shown on the platform pages. Null = the frontend's
  // built-in default.
  siteName        String?
  siteHeroBadge   String?
  supportEmail    String?
  supportWhatsapp String?
  demoStudioSlug  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_config")
}

// A studio's scrolling promo banner (advertised on the shop and/or booking
// pages). Tenant-scoped like the rest of the storefront content.
model PromoBanner {
  id        String         @id @default(cuid())
  studioId  String?
  message   String
  linkUrl   String?
  bgColor   String? // hex; falls back to the studio's primary color
  textColor String?
  placement PromoPlacement @default(BOTH)
  active    Boolean        @default(true)
  order     Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("promo_banners")
}

// ------------------- Tenant-owned models -------------------

model User {
  id       String  @id @default(cuid())
  // Super admins belong to no studio (studioId is null); customers/admins do.
  studioId String?
  email    String
  password String
  role     Role    @default(CUSTOMER)

  resetToken       String?
  resetTokenExpiry DateTime?

  profile             Profile?
  appointments        Appointment[]
  reviews             Review[]
  loyaltyPoints       LoyaltyPoints?
  loyaltyTransactions LoyaltyTransaction[]
  referralCode        ReferralCode?
  referralsMade       Referral[]           @relation("Referrer")
  referralReceived    Referral?            @relation("Referred")
  cart                Cart?
  orders              Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Email is unique per studio, not globally (same email can exist in two
  // studios). Super admins (studioId null) are effectively globally unique.
  @@unique([studioId, email])
  @@index([studioId])
  @@index([role])
  @@map("users")
}

// Server-side bearer-token sessions allow immediate revocation and enforce a
// maximum number of active devices per account.
model AuthSession {
  id        String   @id
  userId    String
  studioId  String?
  deviceKey String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([userId, deviceKey])
  @@map("auth_sessions")
}

// A browser-generated random identifier, hashed by the API. This remembers
// known browsers after their active sessions expire so alerts are one-time per
// newly seen device rather than on every login.
model AuthDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceKey   String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  @@unique([userId, deviceKey])
  @@index([userId, lastSeenAt])
  @@map("auth_devices")
}

model Profile {
  id       String  @id @default(cuid())
  studioId String?
  userId   String  @unique
  fullName String?
  email    String?
  phone    String?
  avatar   String?
  location String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("profiles")
}

model Appointment {
  id              String            @id @default(cuid())
  studioId        String?
  fullName        String
  phone           String
  email           String?
  appointmentDate DateTime
  appointmentTime String
  notes           String?
  designImageUrl  String?
  status          AppointmentStatus @default(PENDING)

  // Original service price at time of booking.
  totalPrice     Float?
  // Loyalty discount applied to this booking (amount due = totalPrice - discountAmount).
  discountAmount Float   @default(0)
  pointsRedeemed Int     @default(0)
  pointsRefunded Boolean @default(false)

  // Previous slot, kept when an appointment is moved so the customer's email can
  // show "was X, now Y" and the studio has a trail. Only the most recent move is
  // retained — a full history would need its own table.
  rescheduledFromDate DateTime?
  rescheduledFromTime String?
  rescheduledAt       DateTime?

  // Nullable so guests (not logged in) can book
  userId    String?
  serviceId String

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  payment             Payment?
  reviews             Review[]
  loyaltyTransactions LoyaltyTransaction[]
  // Products bought as part of this booking (separate revenue bucket).
  // One-to-many at the schema level (Mongo unique-null limitation); at most one
  // product order per appointment is enforced in application code.
  productOrders       Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@index([userId])
  @@map("appointments")
}

model Service {
  id          String  @id @default(cuid())
  studioId    String?
  name        String
  category    String // Category slug (see Category model)
  description String?
  price       Float
  // When set (and below price), this is an active promotional price.
  promoPrice  Float?
  duration    String // Human readable, e.g. "2 hrs"
  popular     Boolean @default(false)
  active      Boolean @default(true)
  imageUrl    String?

  appointments Appointment[]
  addOns       ServiceAddOn[]
  reviews      Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("services")
}

model ServiceAddOn {
  id        String  @id @default(cuid())
  studioId  String?
  name      String
  price     Float
  duration  Int // Additional minutes
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([studioId])
  @@map("service_addons")
}

model Payment {
  id            String        @id @default(cuid())
  studioId      String?
  // Amount charged in this Paystack transaction (deposit or full), in GHS.
  amount        Float
  // Full amount due for the booking (for a partial payment, the balance is
  // totalAmount - amount, payable at the studio).
  totalAmount   Float         @default(0)
  type          PaymentType   @default(FULL)
  status        PaymentStatus @default(PENDING)
  currency      String        @default("GHS")
  // Reference we generate and hand to Paystack; Paystack echoes it back.
  // Always set (a generated UUID), globally unique so verify/webhook can find it.
  reference     String?       @unique
  // Paystack's own transaction id, captured on verify. Not unique: it's null
  // until paid, and a Mongo unique index only allows a single null document.
  transactionId String?
  channel       String?
  paidAt        DateTime?

  // Sum of PROCESSED refunds against this payment. `amount - refundedAmount` is
  // what the studio actually kept.
  refundedAmount Float @default(0)

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("payments")
}

// Per-studio payment policy (one document per studio).
// When enabled, a booking must be paid (full and/or partial, per the flags)
// before it's finalized; when disabled, bookings are created payment-pending.
model PaymentSettings {
  id             String  @id @default(cuid())
  studioId       String? @unique
  enabled        Boolean @default(false)
  allowFull      Boolean @default(true)
  allowPartial   Boolean @default(false)
  depositPercent Int     @default(50) // % of amount due required as a deposit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_settings")
}

model Review {
  id       String  @id @default(cuid())
  studioId String?
  rating   Int // 1-5
  content  String?
  approved Boolean @default(false)

  userId        String
  serviceId     String?
  appointmentId String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  service     Service?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([studioId])
  @@index([approved])
  @@map("reviews")
}

model Gallery {
  id        String    @id @default(cuid())
  studioId  String?
  title     String?
  imageUrl  String
  mediaType MediaType @default(IMAGE)
  category  String // Category slug (see Category model)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([studioId])
  @@map("gallery")
}

// Per-studio service/gallery categories with public visibility control.
model Category {
  id       String  @id @default(cuid())
  studioId String?
  name     String
  slug     String
  active   Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studioId, slug])
  @@index([studioId])
  @@map("categories")
}

model BusinessHours {
  id        String  @id @default(cuid())
  studioId  String?
  dayOfWeek Int // 0 (Sunday) to 6 (Saturday)
  openTime  String? // e.g., "09:00"
  closeTime String? // e.g., "17:00"
  isClosed  Boolean @default(false)

  @@unique([studioId, dayOfWeek])
  @@index([studioId])
  @@map("business_hours")
}

model BlockedDate {
  id       String   @id @default(cuid())
  studioId String?
  date     DateTime
  reason   String?

  @@index([studioId])
  @@map("blocked_dates")
}

// Per-studio contact details (one document per studio).
model ContactInfo {
  id        String  @id @default(cuid())
  studioId  String? @unique
  phone     String?
  whatsapp  String?
  email     String?
  instagram String?
  tiktok    String?
  facebook  String?
  address   String?

  showPhone     Boolean @default(true)
  showWhatsapp  Boolean @default(true)
  showEmail     Boolean @default(true)
  showInstagram Boolean @default(true)
  showTiktok    Boolean @default(true)
  showFacebook  Boolean @default(true)
  showAddress   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_info")
}

model LoyaltyPoints {
  id             String  @id @default(cuid())
  studioId       String?
  userId         String  @unique
  points         Int     @default(0)
  lifetimePoints Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("loyalty_points")
}

model LoyaltyTransaction {
  id            String                 @id @default(cuid())
  studioId      String?
  userId        String
  points        Int
  type          LoyaltyTransactionType
  description   String?
  appointmentId String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([studioId])
  @@index([userId])
  @@map("loyalty_transactions")
}

model ReferralCode {
  id       String  @id @default(cuid())
  studioId String?
  userId   String  @unique
  code     String
  uses     Int     @default(0)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  createdAt DateTime @default(now())

  @@unique([studioId, code])
  @@index([studioId])
  @@map("referral_codes")
}

model Referral {
  id             String  @id @default(cuid())
  studioId       String?
  referrerId     String
  referredId     String  @unique
  referralCodeId String
  rewarded       Boolean @default(false)

  referrer     User         @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred     User         @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([studioId])
  @@index([referrerId])
  @@map("referrals")
}

// ------------------- Commerce (mini shop) -------------------

model Product {
  id          String  @id @default(cuid())
  studioId    String?
  name        String
  description String?
  price       Float
  // Cost to the studio; profit (revenue) = selling price - cost. Optional.
  costPrice   Float   @default(0)
  // When set (and below price), an active promotional price.
  promoPrice  Float?
  imageUrl    String?
  category    String // ProductCategory slug
  stock       Int     @default(0)
  trackStock  Boolean @default(true)
  active      Boolean @default(true)
  popular     Boolean @default(false)

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("products")
}

// Per-studio product categories, independent of service categories.
model ProductCategory {
  id       String  @id @default(cuid())
  studioId String?
  name     String
  slug     String
  active   Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studioId, slug])
  @@index([studioId])
  @@map("product_categories")
}

model Cart {
  id       String     @id @default(cuid())
  studioId String?
  userId   String     @unique
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  studioId  String?
  cartId    String
  productId String
  quantity  Int     @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@index([studioId])
  @@map("cart_items")
}

model Order {
  id          String      @id @default(cuid())
  studioId    String?
  orderNumber String
  // Null for guest orders (purchases without an account).
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       OrderItem[]

  // Contact snapshot (guests, or a copy for logged-in buyers).
  customerName  String?
  customerEmail String?
  customerPhone String?

  // Sum of PROCESSED refunds against this order.
  refundedAmount Float @default(0)

  subtotal       Float
  // Loyalty redemption applied to the product subtotal (customers only).
  discountAmount Float       @default(0)
  pointsRedeemed Int         @default(0)
  pointsRefunded Boolean     @default(false)
  deliveryFee    Float       @default(0)
  total          Float
  status         OrderStatus @default(PENDING_PAYMENT)

  fulfillment     FulfillmentType @default(PICKUP)
  deliveryAddress String?
  deliveryPhone   String?

  // A referral code used at checkout (rewards the code owner once per buyer).
  referralCode String?

  // When products are bought as part of a booking, the order links here so
  // revenue can be split (service -> booking, products -> product). Not unique
  // (Mongo rejects multiple null values); at most one is enforced in code.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // Paystack payment fields (reference always set to a generated UUID; shared
  // with the appointment Payment for a combined booking+products charge).
  reference     String?   @unique
  transactionId String?
  channel       String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studioId, orderNumber])
  @@index([studioId])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  studioId  String?
  orderId   String
  productId String?
  // Snapshot so order history is stable if the product later changes/deletes.
  name      String
  unitPrice Float
  costPrice Float   @default(0)
  quantity  Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([studioId])
  @@map("order_items")
}

// De-dups the referral reward so a referrer earns 50 pts once per new buyer.
model ReferralOrderReward {
  id             String   @id @default(cuid())
  studioId       String?
  referralCodeId String
  buyerEmail     String
  createdAt      DateTime @default(now())

  @@unique([referralCodeId, buyerEmail])
  @@index([studioId])
  @@map("referral_order_rewards")
}

// Per-studio shop policy (one document per studio).
model CommerceSettings {
  id             String  @id @default(cuid())
  studioId       String? @unique
  enabled        Boolean @default(true) // show the shop publicly
  enablePickup   Boolean @default(true)
  enableDelivery Boolean @default(true)
  deliveryFee    Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commerce_settings")
}

// ---------------------------------------------------------------------------
// Money: payment attempts + the studio ledger
// ---------------------------------------------------------------------------

// Where a ledger entry came from. Kept coarse — the source row ids carry detail.
enum LedgerEntryType {
  BOOKING_PAYMENT
  ORDER_PAYMENT
  SUBSCRIPTION_PAYMENT
  REFUND
  ADJUSTMENT
}

// Money in (to the studio) vs money out.
enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
}

/// One Paystack transaction attempt. Immutable identity: a `reference` is
/// written once and never rewritten, so a customer who abandons a checkout and
/// retries produces TWO rows. That is the point — if the abandoned attempt is
/// later completed on their phone, the webhook can still find it. (The old
/// design rotated `reference` on a single Payment row, which orphaned the first
/// attempt and lost the money.)
model PaymentAttempt {
  id       String  @id @default(cuid())
  studioId String?

  // Handed to Paystack; globally unique so a webhook can resolve it with no
  // tenant context.
  reference String @unique

  // Exactly one of these is set — what the attempt is paying for. A combined
  // booking+products charge sets both.
  paymentId     String?
  orderId       String?
  appointmentId String?

  // What we asked Paystack to charge, in GHS. Compared against the verified
  // amount before anything is marked paid.
  expectedAmount Float
  currency       String @default("GHS")

  status LedgerStatus @default(PENDING)

  // Filled in from Paystack's verify response.
  paidAmount    Float?
  transactionId String?
  channel       String?
  paidAt        DateTime?
  failureReason String?

  // Customer snapshot, so an attempt stays readable if the booking is deleted.
  customerEmail String?
  customerName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, createdAt])
  @@index([paymentId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("payment_attempts")
}

/// Append-only ledger of every money movement on a studio. One row per
/// settled (or definitively failed) transaction, written at the moment it is
/// finalized. Never updated in place — a reversal is its own DEBIT row.
model LedgerEntry {
  id       String  @id @default(cuid())
  studioId String?

  type      LedgerEntryType
  direction LedgerDirection
  status    LedgerStatus

  // Positive magnitude in `currency`; `direction` carries the sign.
  amount   Float
  currency String @default("GHS")

  // Idempotency guard. Built from the source + reference (see LedgerService),
  // so a replayed webhook or a reconcile sweep cannot double-post.
  dedupeKey String @unique

  reference     String?
  transactionId String?
  channel       String?

  // Human-readable snapshot, frozen at write time so the ledger still reads
  // correctly after a service is renamed or a booking is deleted.
  description   String
  customerName  String?
  customerEmail String?

  // Soft links to the source rows (no FK: the ledger must outlive them).
  paymentAttemptId String?
  paymentId        String?
  orderId          String?
  appointmentId    String?

  // Who caused it, for the "by their customers and they themself" split.
  actorEmail String?
  actorRole  String?

  // When the money actually moved (Paystack's paid_at when known).
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([studioId, occurredAt])
  @@index([studioId, type, occurredAt])
  @@index([studioId, status])
  @@index([reference])
  @@map("ledger_entries")
}

// Refunds

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

/// A refund issued against a booking payment or a shop order.
///
/// Money moves back to the customer through Paystack, so a Refund row is a
/// record of a request whose outcome arrives asynchronously (webhook
/// refund.processed / refund.failed) — never assume PENDING means refunded.
/// Partial refunds are supported: several rows can point at one payment, and
/// Payment.refundedAmount / Order.refundedAmount carry the running total.
model Refund {
  id       String  @id @default(cuid())
  studioId String?

  // Exactly one of these is set — what is being refunded.
  paymentId     String?
  orderId       String?
  appointmentId String?

  // Amount returned to the customer, in `currency`. Never exceeds the amount
  // actually collected minus what has already been refunded.
  amount   Float
  currency String @default("GHS")

  status RefundStatus @default(PENDING)
  // Studio-supplied note ("customer cancelled"), shown on the refund document.
  reason String?

  // Our own reference (RF-…), globally unique so a webhook can resolve it with
  // no tenant context.
  reference        String    @unique
  // The Paystack transaction being reversed, and their id for the refund.
  transactionId    String?
  providerRefundId String?
  failureReason    String?
  processedAt      DateTime?

  // Customer snapshot, so the record stays readable if the booking is deleted.
  customerName  String?
  customerEmail String?

  // Who issued it (studio admin or super admin).
  initiatedByEmail String?
  initiatedByRole  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, createdAt])
  @@index([paymentId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("refunds")
}
