// ------------------- Commerce (mini shop) -------------------

model Product {
  id          String   @id @default(cuid())
  studioId    String?
  name        String
  description String?
  price       Float
  // Cost to the studio; profit (revenue) = selling price - cost. Optional.
  costPrice   Float    @default(0)
  // When set (and below price), an active promotional price.
  promoPrice  Float?
  // Set when promoPrice came from a scheduled sale (e.g. Black Friday) rather
  // than the owner, so the sale can take it off again when the day ends.
  salePromoId String?
  imageUrl    String?
  // More photos shown after imageUrl on the product page.
  images      String[] @default([])
  // Options the buyer picks from. Stock is per product, not per option.
  sizes       String[] @default([])
  // "Name|#hex", e.g. "Sand|#C2B280".
  colors      String[] @default([])
  category    String // ProductCategory slug
  // Who it's for, so a shop can show Men and Women sections: MEN | WOMEN | UNISEX.
  audience    String   @default("UNISEX")
  brand       String?
  // Facts shown as a table on the product page, "Label|Value" (e.g. "Fabric|Cotton").
  attributes  String[] @default([])
  stock       Int      @default(0)
  trackStock  Boolean  @default(true)
  active      Boolean  @default(true)
  popular     Boolean  @default(false)

  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlist   WishlistItem[]
  reviews    Review[]

  // When admins were last told it was running low; cleared on restock.
  lowStockAlertedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([studioId])
  @@map("products")
}

// Per-studio product categories, independent of service categories.
model ProductCategory {
  id       String  @id @default(cuid())
  studioId String?
  name     String
  slug     String
  active   Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studioId, slug])
  @@index([studioId])
  @@map("product_categories")
}

model Cart {
  id       String     @id @default(cuid())
  studioId String?
  userId   String     @unique
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  studioId  String?
  cartId    String
  productId String
  quantity  Int     @default(1)
  // The chosen options; empty when the product has none.
  size      String  @default("")
  color     String  @default("")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([cartId, productId, size, color])
  @@index([studioId])
  @@map("cart_items")
}

model Order {
  id          String      @id @default(cuid())
  studioId    String?
  orderNumber String
  // Null for guest orders (purchases without an account).
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       OrderItem[]

  // Contact snapshot (guests, or a copy for logged-in buyers).
  customerName  String?
  customerEmail String?
  customerPhone String?

  // Sum of PROCESSED refunds against this order.
  refundedAmount Float @default(0)

  subtotal       Float
  // Loyalty redemption applied to the product subtotal (customers only).
  discountAmount Float       @default(0)
  pointsRedeemed Int         @default(0)
  pointsRefunded Boolean     @default(false)
  deliveryFee    Float       @default(0)
  total          Float
  status         OrderStatus @default(PENDING_PAYMENT)

  fulfillment     FulfillmentType @default(PICKUP)
  deliveryAddress String?
  deliveryPhone   String?
  deliveryZone    String?
  // The day and window the customer chose, e.g. "Sat 15 Nov, Morning (9am–12pm)".
  deliverySlot    String?

  // A referral code used at checkout (rewards the code owner once per buyer).
  referralCode String?

  // A coupon used at checkout. Its amount is included in discountAmount.
  couponCode     String?
  couponDiscount Float   @default(0)

  // When products are bought as part of a booking, the order links here so
  // revenue can be split (service -> booking, products -> product). Not unique
  // (Mongo rejects multiple null values); at most one is enforced in code.
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // Paystack payment fields (reference always set to a generated UUID; shared
  // with the appointment Payment for a combined booking+products charge).
  reference     String?   @unique
  transactionId String?
  channel       String?
  paidAt        DateTime?

  // The customer asked to cancel; the studio approves (status CANCELLED) or
  // declines (cleared). Refunds are settled by the studio outside the app.
  cancelRequestedAt     DateTime?
  cancelRequestReason   String?   @db.VarChar(500)
  // The studio paid the customer back itself (Mobile Money, cash, bank) and
  // recorded it here. No money moves through the platform.
  refundedOutsideAt     DateTime?
  refundedOutsideAmount Float?
  refundedOutsideNote   String?   @db.VarChar(300)
  // Paystack fee the customer paid on top of the price (0 when the business pays it).
  processingFee         Float     @default(0)
  // A gift card or package used on it, and how much it covered (already
  // included in discountAmount).
  voucherId             String?
  voucherAmount         Float     @default(0)
  // Delivery and pickup: the customer's note for the rider, the expected time
  // the shop gives, and when the stage last changed (to spot stuck orders).
  deliveryNote          String?   @db.VarChar(300)
  deliveryEta           String?   @db.VarChar(60)
  statusUpdatedAt       DateTime?
  // The customer's code, given to the rider (or at the counter) to confirm
  // the handover. The rider's link works with riderToken until it's used.
  handoverCode          String?
  riderToken            String?   @unique
  riderTokenExpires     DateTime?
  deliveredAt           DateTime?
  deliveryFailedAt      DateTime?
  deliveryFailReason    String?   @db.VarChar(200)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([studioId, orderNumber])
  @@index([studioId])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  studioId  String?
  orderId   String
  productId String?
  // Snapshot so order history is stable if the product later changes/deletes.
  name      String
  unitPrice Float
  costPrice Float   @default(0)
  quantity  Int
  size      String?
  color     String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([studioId])
  @@map("order_items")
}

// De-dups the referral reward so a referrer earns 50 pts once per new buyer.
model ReferralOrderReward {
  id             String   @id @default(cuid())
  studioId       String?
  referralCodeId String
  buyerEmail     String
  createdAt      DateTime @default(now())

  @@unique([referralCodeId, buyerEmail])
  @@index([studioId])
  @@map("referral_order_rewards")
}

// Per-studio shop policy (one document per studio).
model CommerceSettings {
  id                String  @id @default(cuid())
  studioId          String? @unique
  enabled           Boolean @default(true) // show the shop publicly
  enablePickup      Boolean @default(true)
  enableDelivery    Boolean @default(true)
  deliveryFee       Float   @default(0)
  // Delivery areas with their own fee: [{ id, name, fee }]. Empty = the flat fee above.
  deliveryZones     Json    @default("[]")
  // Time windows customers pick from: ["Morning (9am–12pm)", ...]. Empty = no choice.
  deliverySlots     Json    @default("[]")
  // Admins are told when a product's stock falls to this or below.
  lowStockThreshold Int     @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commerce_settings")
}

// ---------------------------------------------------------------------------
// Money: payment attempts + the studio ledger
// ---------------------------------------------------------------------------

// Where a ledger entry came from. Kept coarse — the source row ids carry detail.
enum LedgerEntryType {
  BOOKING_PAYMENT
  ORDER_PAYMENT
  SUBSCRIPTION_PAYMENT
  REFUND
  ADJUSTMENT
}

// Money in (to the studio) vs money out.
enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  REVERSED
}

/// One Paystack transaction attempt. Immutable identity: a `reference` is
/// written once and never rewritten, so a customer who abandons a checkout and
/// retries produces TWO rows. That is the point — if the abandoned attempt is
/// later completed on their phone, the webhook can still find it. (The old
/// design rotated `reference` on a single Payment row, which orphaned the first
/// attempt and lost the money.)
model PaymentAttempt {
  id       String  @id @default(cuid())
  studioId String?

  // Handed to Paystack; globally unique so a webhook can resolve it with no
  // tenant context.
  reference String @unique

  // Exactly one of these is set — what the attempt is paying for. A combined
  // booking+products charge sets both.
  paymentId     String?
  orderId       String?
  appointmentId String?
  billId        String?

  // What we asked Paystack to charge, in GHS. Compared against the verified
  // amount before anything is marked paid.
  expectedAmount Float
  // Paystack fee the customer paid on top of the price (0 when the business pays it).
  processingFee  Float  @default(0)
  currency       String @default("GHS")

  status LedgerStatus @default(PENDING)

  // Filled in from Paystack's verify response.
  paidAmount    Float?
  transactionId String?
  channel       String?
  paidAt        DateTime?
  failureReason String?

  // Customer snapshot, so an attempt stays readable if the booking is deleted.
  customerEmail String?
  customerName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, createdAt])
  @@index([paymentId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("payment_attempts")
}

/// Append-only ledger of every money movement on a studio. One row per
/// settled (or definitively failed) transaction, written at the moment it is
/// finalized. Never updated in place — a reversal is its own DEBIT row.
model LedgerEntry {
  id       String  @id @default(cuid())
  studioId String?

  type      LedgerEntryType
  direction LedgerDirection
  status    LedgerStatus

  // Positive magnitude in `currency`; `direction` carries the sign.
  amount   Float
  currency String @default("GHS")

  // Idempotency guard. Built from the source + reference (see LedgerService),
  // so a replayed webhook or a reconcile sweep cannot double-post.
  dedupeKey String @unique

  reference     String?
  transactionId String?
  channel       String?

  // Human-readable snapshot, frozen at write time so the ledger still reads
  // correctly after a service is renamed or a booking is deleted.
  description   String
  customerName  String?
  customerEmail String?

  // Soft links to the source rows (no FK: the ledger must outlive them).
  paymentAttemptId String?
  paymentId        String?
  orderId          String?
  appointmentId    String?

  // Who caused it, for the "by their customers and they themself" split.
  actorEmail String?
  actorRole  String?

  // When the money actually moved (Paystack's paid_at when known).
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([studioId, occurredAt])
  @@index([studioId, type, occurredAt])
  @@index([studioId, status])
  @@index([reference])
  @@map("ledger_entries")
}

// Refunds

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

/// A refund issued against a booking payment or a shop order.
///
/// Money moves back to the customer through Paystack, so a Refund row is a
/// record of a request whose outcome arrives asynchronously (webhook
/// refund.processed / refund.failed) — never assume PENDING means refunded.
/// Partial refunds are supported: several rows can point at one payment, and
/// Payment.refundedAmount / Order.refundedAmount carry the running total.
model Refund {
  id       String  @id @default(cuid())
  studioId String?

  // Exactly one of these is set — what is being refunded.
  paymentId     String?
  orderId       String?
  appointmentId String?

  // Amount returned to the customer, in `currency`. Never exceeds the amount
  // actually collected minus what has already been refunded.
  amount   Float
  currency String @default("GHS")

  status RefundStatus @default(PENDING)
  // Studio-supplied note ("customer cancelled"), shown on the refund document.
  reason String?

  // Our own reference (RF-…), globally unique so a webhook can resolve it with
  // no tenant context.
  reference        String    @unique
  // The Paystack transaction being reversed, and their id for the refund.
  transactionId    String?
  providerRefundId String?
  failureReason    String?
  processedAt      DateTime?

  // Customer snapshot, so the record stays readable if the booking is deleted.
  customerName  String?
  customerEmail String?

  // Who issued it (studio admin or super admin).
  initiatedByEmail String?
  initiatedByRole  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId, createdAt])
  @@index([paymentId])
  @@index([orderId])
  @@index([status, createdAt])
  @@map("refunds")
}

// Pictures a studio made with the image maker in its admin. Also counts
// towards the monthly limit (env AI_IMAGES_PER_MONTH).
model GeneratedImage {
  id        String   @id @default(cuid())
  studioId  String
  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  prompt    String
  // hero | gallery | product | service: decides where the file is stored.
  purpose   String
  url       String
  createdAt DateTime @default(now())

  @@index([studioId, createdAt])
}

// Wrong-password tracking for login lockouts (auth/loginLockout). Keyed by a
// hash of studio + email, so unknown emails behave the same as real ones.
model LoginLockout {
  key          String    @id
  failedCount  Int       @default(0)
  lockCount    Int       @default(0)
  lockedUntil  DateTime?
  lastFailedAt DateTime  @default(now())

  @@index([lastFailedAt])
}

// A signup's email code, proving the owner controls the address before they
// pay. The code is stored hashed and the row is removed once it's used.
model EmailVerification {
  email     String   @id
  codeHash  String
  attempts  Int      @default(0)
  sentAt    DateTime
  expiresAt DateTime
}

// A product a customer saved for later.
model WishlistItem {
  id        String   @id @default(cuid())
  studioId  String?
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([studioId])
}

enum CouponType {
  PERCENT
  FIXED
}

// A shop discount code. usedCount rises when an order using it is paid.
model Coupon {
  id          String     @id @default(cuid())
  studioId    String?
  code        String
  type        CouponType
  value       Float
  minSubtotal Float      @default(0)
  maxUses     Int?
  usedCount   Int        @default(0)
  expiresAt   DateTime?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())

  @@unique([studioId, code])
  @@index([studioId])
}

// A platform billing promo: % off what a studio or store owner pays (signup,
// renewal, plan change). Managed in the super admin's Billing page.
model BillingPromo {
  id         String    @id @default(cuid())
  code       String    @unique
  percentOff Float
  // Plans it works for; empty means every plan.
  plans      String[]  @default([])
  expiresAt  DateTime?
  maxUses    Int?
  usedCount  Int       @default(0)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@map("billing_promos")
}
