generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "mongodb"
  url = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentType {
  FULL
  PARTIAL
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  REFERRAL_BONUS
  REFUND
  EXPIRED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLED
  CANCELLED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

model User {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  email    String    @unique
  password String
  role     Role      @default(CUSTOMER)

  resetToken       String?
  resetTokenExpiry DateTime?

  profile             Profile?
  appointments        Appointment[]
  reviews             Review[]
  loyaltyPoints       LoyaltyPoints?
  loyaltyTransactions LoyaltyTransaction[]
  referralCode        ReferralCode?
  referralsMade       Referral[] @relation("Referrer")
  referralReceived    Referral?  @relation("Referred")
  cart                Cart?
  orders              Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

model Profile {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  userId    String  @db.ObjectId @unique
  fullName  String?
  email     String?
  phone     String?
  avatar    String?
  location  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Appointment {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  fullName        String
  phone           String
  email           String?
  appointmentDate DateTime
  appointmentTime String
  notes           String?
  designImageUrl  String?
  status          AppointmentStatus @default(PENDING)

  // Original service price at time of booking.
  totalPrice      Float?
  // Loyalty discount applied to this booking (amount due = totalPrice - discountAmount).
  discountAmount  Float             @default(0)
  pointsRedeemed  Int               @default(0)
  pointsRefunded  Boolean           @default(false)

  // Nullable so guests (not logged in) can book
  userId          String?           @db.ObjectId
  serviceId       String            @db.ObjectId

  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  payment             Payment?
  reviews             Review[]
  loyaltyTransactions LoyaltyTransaction[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@map("appointments")
}

model Service {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  category     String          // Category slug (see Category model)
  description  String?
  price        Float
  // When set (and below price), this is an active promotional price.
  promoPrice   Float?
  duration     String          // Human readable, e.g. "2 hrs"
  popular      Boolean         @default(false)
  active       Boolean         @default(true)
  imageUrl     String?

  appointments Appointment[]
  addOns       ServiceAddOn[]
  reviews      Review[]

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("services")
}

model ServiceAddOn {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  price       Float
  duration    Int      // Additional minutes
  serviceId   String   @db.ObjectId
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_addons")
}

model Payment {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  // Amount charged in this Paystack transaction (deposit or full), in GHS.
  amount        Float
  // Full amount due for the booking (for a partial payment, the balance is
  // totalAmount - amount, payable at the studio).
  totalAmount   Float         @default(0)
  type          PaymentType   @default(FULL)
  status        PaymentStatus @default(PENDING)
  currency      String        @default("GHS")
  // Reference we generate and hand to Paystack; Paystack echoes it back.
  // Always set (a generated UUID), so a unique index is safe on Mongo.
  reference     String?       @unique
  // Paystack's own transaction id, captured on verify. Not unique: it's null
  // until paid, and a Mongo unique index only allows a single null document.
  transactionId String?
  channel       String?
  paidAt        DateTime?

  appointmentId String        @unique @db.ObjectId
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

// Admin-controlled payment policy (single document).
// When enabled, a booking must be paid (full and/or partial, per the flags)
// before it's finalized; when disabled, bookings are created payment-pending.
model PaymentSettings {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  enabled        Boolean  @default(false)
  allowFull      Boolean  @default(true)
  allowPartial   Boolean  @default(false)
  depositPercent Int      @default(50) // % of amount due required as a deposit

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("payment_settings")
}

model Review {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  rating        Int          // 1-5
  content       String?
  approved      Boolean      @default(false)

  userId        String       @db.ObjectId
  serviceId     String?      @db.ObjectId
  appointmentId String?      @db.ObjectId

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  service       Service?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())

  @@index([approved])
  @@map("reviews")
}

model Gallery {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  title     String?
  imageUrl  String
  mediaType MediaType       @default(IMAGE)
  category  String          // Category slug (see Category model)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@map("gallery")
}

// Admin-managed service/gallery categories with public visibility control.
model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model BusinessHours {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  dayOfWeek   Int      @unique // 0 (Sunday) to 6 (Saturday)
  openTime    String?  // e.g., "09:00"
  closeTime   String?  // e.g., "17:00"
  isClosed    Boolean  @default(false)

  @@map("business_hours")
}

model BlockedDate {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  date    DateTime
  reason  String?

  @@map("blocked_dates")
}

model ContactInfo {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  phone         String?
  whatsapp      String?
  email         String?
  instagram     String?
  tiktok        String?
  address       String?

  showPhone     Boolean  @default(true)
  showWhatsapp  Boolean  @default(true)
  showEmail     Boolean  @default(true)
  showInstagram Boolean  @default(true)
  showTiktok    Boolean  @default(true)
  showAddress   Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("contact_info")
}

model LoyaltyPoints {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId @unique
  points         Int      @default(0)
  lifetimePoints Int      @default(0)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("loyalty_points")
}

model LoyaltyTransaction {
  id            String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId        String                 @db.ObjectId
  points        Int
  type          LoyaltyTransactionType
  description   String?
  appointmentId String?                @db.ObjectId

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment   Appointment?           @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  createdAt     DateTime               @default(now())

  @@index([userId])
  @@map("loyalty_transactions")
}

model ReferralCode {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @db.ObjectId @unique
  code      String     @unique
  uses      Int        @default(0)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  createdAt DateTime   @default(now())

  @@map("referral_codes")
}

model Referral {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  referrerId     String       @db.ObjectId
  referredId     String       @db.ObjectId @unique
  referralCodeId String       @db.ObjectId
  rewarded       Boolean      @default(false)

  referrer       User         @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred       User         @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())

  @@index([referrerId])
  @@map("referrals")
}

// ------------------- Commerce (mini shop) -------------------

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  price       Float
  // Cost to the studio; profit (revenue) = selling price - cost. Optional.
  costPrice   Float    @default(0)
  // When set (and below price), an active promotional price.
  promoPrice  Float?
  imageUrl    String?
  category    String   // ProductCategory slug
  stock       Int      @default(0)
  trackStock  Boolean  @default(true)
  active      Boolean  @default(true)
  popular     Boolean  @default(false)

  cartItems   CartItem[]
  orderItems  OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

// Admin-managed product categories, independent of service categories.
model ProductCategory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_categories")
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @db.ObjectId @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String   @db.ObjectId
  productId String   @db.ObjectId
  quantity  Int      @default(1)

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber     String          @unique
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  subtotal        Float
  deliveryFee     Float           @default(0)
  total           Float
  status          OrderStatus     @default(PENDING_PAYMENT)

  fulfillment     FulfillmentType @default(PICKUP)
  deliveryAddress String?
  deliveryPhone   String?

  // Paystack payment fields (reference always set to a generated UUID).
  reference       String?         @unique
  transactionId   String?
  channel         String?
  paidAt          DateTime?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String   @db.ObjectId
  productId String?  @db.ObjectId
  // Snapshot so order history is stable if the product later changes/deletes.
  name      String
  unitPrice Float
  quantity  Int

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

// Admin-controlled shop policy (single document).
model CommerceSettings {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  enabled        Boolean  @default(true)  // show the shop publicly
  enablePickup   Boolean  @default(true)
  enableDelivery Boolean  @default(true)
  deliveryFee    Float    @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("commerce_settings")
}
